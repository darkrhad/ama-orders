rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the café login (Authentication → Users) may back up.
    match /orders/{id} {
      allow read, write: if request.auth != null
        && request.auth.uid == '0vTnELJXgfbOQPz6cnhikSRKeLj2';
    }
  }
}
